# Solo se sirve desde gba.cooryc.com: cooryc.com/gba redirige alli
RewriteEngine On
RewriteCond %{HTTP_HOST} !^gba\.cooryc\.com$ [NC]
RewriteRule ^(.*)$ https://gba.cooryc.com/$1 [R=301,L]

# ads.txt de AdSense, generado con el id de editor de config.php
RewriteRule ^ads\.txt$ api/ads-txt.php [L]

# No indexar en buscadores
Header set X-Robots-Tag "noindex, nofollow"
Options -Indexes

# Tipos correctos para WebAssembly y ROMs
AddType application/wasm .wasm
AddType application/octet-stream .gba .gb .gbc

# No cachear index/app para ver los cambios al momento
<FilesMatch "\.(html|js|json)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
